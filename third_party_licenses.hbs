<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>KoldStore third-party notices</title>
</head>
<body>
  <h1>KoldStore third-party notices</h1>
  <p>
    This file is generated from the locked Rust dependency graph. It applies to
    the KoldStore release artifact that contains this file.
  </p>
  {{#each licenses}}
  <section id="{{id}}">
    <h2>{{name}} ({{id}})</h2>
    <h3>Used by</h3>
    <ul>
      {{#each used_by}}
      <li>{{crate.name}} {{crate.version}}</li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
