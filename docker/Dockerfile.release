# syntax=docker/dockerfile:1
#
# Release runtime — PostgreSQL + prebuilt koldstore + pg_cron.
# Does not compile the extension; copy artifacts from the release tarball.
#
# Build context: repository root, with extracted extension files in
# docker-artifacts/ (koldstore.so, koldstore.control, koldstore--*.sql).
#
#   # PostgreSQL 18 (default / :latest)
#   docker build -f docker/Dockerfile.release \
#     --build-arg PG_MAJOR=18 \
#     -t pg-koldstore:18 .
#
#   # PostgreSQL 16 (still published as :<version>-pg16)
#   docker build -f docker/Dockerfile.release \
#     --build-arg PG_MAJOR=16 \
#     --build-arg OCI_IMAGE_DESCRIPTION="PostgreSQL 16 with koldstore preinstalled for trying KoldStore quickly." \
#     -t pg-koldstore:16 .
#
# Base is Ubuntu 24.04 + PGDG PostgreSQL so the prebuilt ubuntu24.04
# package (amd64 or arm64) matches the runtime glibc. Build each arch with
# its matching docker-artifacts/koldstore.so; release CI publishes multi-arch
# manifests for both PG majors (`latest` tracks PG18).

ARG PG_MAJOR=18
ARG OCI_IMAGE_DESCRIPTION="PostgreSQL 18 with koldstore preinstalled for trying KoldStore quickly."

# Official entrypoint scripts (initdb, POSTGRES_* env, init hooks).
FROM postgres:${PG_MAJOR}-bookworm AS official_postgres

FROM ubuntu:24.04

ARG PG_MAJOR
ARG OCI_IMAGE_DESCRIPTION

LABEL org.opencontainers.image.title="pg-koldstore" \
      org.opencontainers.image.description="${OCI_IMAGE_DESCRIPTION}" \
      org.opencontainers.image.vendor="kalamdb"

ENV DEBIAN_FRONTEND=noninteractive \
    PG_MAJOR=${PG_MAJOR} \
    PATH=/usr/lib/postgresql/${PG_MAJOR}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PGDATA=/var/lib/postgresql/data \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# Vendored PGDG signing key (avoids flaky www.postgresql.org fetches at build time).
COPY scripts/ci/keys/ACCC4CF8.asc /tmp/ACCC4CF8.asc

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      gnupg \
      gosu \
      locales \
      lsb-release \
      libnss-wrapper \
      tzdata; \
    echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen; \
    locale-gen; \
    install -d /usr/share/keyrings; \
    gpg --batch --yes --dearmor -o /usr/share/keyrings/postgresql.gpg /tmp/ACCC4CF8.asc; \
    rm -f /tmp/ACCC4CF8.asc; \
    echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      "postgresql-${PG_MAJOR}" \
      "postgresql-${PG_MAJOR}-cron" \
      "postgresql-client-${PG_MAJOR}"; \
    # Drop the package-manager cluster; the official entrypoint owns PGDATA.
    if command -v pg_dropcluster >/dev/null 2>&1; then \
      pg_dropcluster --stop "${PG_MAJOR}" main || true; \
    fi; \
    rm -rf /var/lib/postgresql/"${PG_MAJOR}" /var/lib/apt/lists/*; \
    mkdir -p /var/lib/postgresql/data /docker-entrypoint-initdb.d /var/run/postgresql; \
    chown -R postgres:postgres /var/lib/postgresql /var/run/postgresql; \
    chmod 2777 /var/run/postgresql

COPY --from=official_postgres /usr/local/bin/docker-entrypoint.sh /usr/local/bin/
COPY --from=official_postgres /usr/local/bin/docker-ensure-initdb.sh /usr/local/bin/

COPY docker-artifacts/koldstore.so /tmp/koldstore/koldstore.so
COPY docker-artifacts/koldstore.control /tmp/koldstore/koldstore.control
COPY docker-artifacts/koldstore--*.sql /tmp/koldstore/
COPY docker-artifacts/LICENSE docker-artifacts/NOTICE docker-artifacts/THIRD_PARTY_NOTICES.html /tmp/koldstore/

COPY docker/release-init/ /docker-entrypoint-initdb.d/
COPY docker/release-entrypoint.sh /usr/local/bin/release-entrypoint.sh

RUN set -eux; \
    EXTDIR="$(pg_config --sharedir)/extension"; \
    LIBDIR="$(pg_config --pkglibdir)"; \
    install -d "${EXTDIR}" "${LIBDIR}"; \
    install -m 0644 /tmp/koldstore/koldstore.control "${EXTDIR}/"; \
    install -m 0644 /tmp/koldstore/koldstore--*.sql "${EXTDIR}/"; \
    install -m 0755 /tmp/koldstore/koldstore.so "${LIBDIR}/koldstore.so"; \
    install -D -m 0644 /tmp/koldstore/LICENSE /usr/share/doc/koldstore/LICENSE; \
    install -m 0644 /tmp/koldstore/NOTICE /usr/share/doc/koldstore/NOTICE; \
    install -m 0644 /tmp/koldstore/THIRD_PARTY_NOTICES.html /usr/share/doc/koldstore/THIRD_PARTY_NOTICES.html; \
    rm -rf /tmp/koldstore; \
    chmod +x /usr/local/bin/release-entrypoint.sh; \
    # Common cold-storage roots for try-it / Windows mapped drives. Entrypoint
    # re-chowns these at start; creating them here documents the mount point.
    mkdir -p /koldstore-data/cold /tmp/koldstore-demo; \
    chown -R postgres:postgres /koldstore-data /tmp/koldstore-demo; \
    chmod -R a+rwX /koldstore-data /tmp/koldstore-demo; \
    # PGDG sample defaults to localhost; Docker port publish needs '*'.
    # koldstore must be preloaded so every backend installs KoldMergeScan
    # planner hooks — otherwise SELECT on managed tables is heap-only.
    # wal_level=logical is required for manage_table / async mirror capture.
    conf_sample="$(pg_config --sharedir)/postgresql.conf.sample"; \
    printf "\n# pg-koldstore release image defaults\n" >> "${conf_sample}"; \
    printf "listen_addresses = '*'\n" >> "${conf_sample}"; \
    printf "shared_preload_libraries = 'koldstore'\n" >> "${conf_sample}"; \
    printf "wal_level = logical\n" >> "${conf_sample}"; \
    printf "log_min_messages = info\n" >> "${conf_sample}"

STOPSIGNAL SIGINT
EXPOSE 5432
VOLUME /var/lib/postgresql/data

ENTRYPOINT ["release-entrypoint.sh"]
CMD ["postgres"]
