{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pg-koldstore.dev/schemas/manifest-root.json",
  "title": "Folder-sharded object-store manifest root",
  "description": "Thin root manifest.json. Segment bodies live in per-folder manifest-shard.json files listed by shards[]. Temporary or final objects not referenced by an active catalog row are not queryable; this export is derived for recovery/EXPORT tooling.",
  "type": "object",
  "required": [
    "version",
    "table",
    "namespace",
    "scope_id",
    "schema_version",
    "max_seq",
    "max_commit_seq",
    "updated_at",
    "shards",
    "files"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "table": {
      "type": "string"
    },
    "namespace": {
      "type": ["string", "null"]
    },
    "scope_id": {
      "type": ["string", "null"],
      "description": "Scope identifier for user-scoped tables; null for shared tables"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "max_seq": {
      "type": "integer",
      "description": "Highest _seq archived in committed cold segments"
    },
    "max_commit_seq": {
      "type": "integer",
      "description": "Highest _commit_seq archived in committed cold segments"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "publish": {
      "$ref": "#/$defs/publishState"
    },
    "shards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shardRef"
      }
    },
    "files": {
      "$ref": "#/$defs/filesState"
    }
  },
  "not": {
    "required": ["segments"],
    "properties": {
      "segments": {
        "type": "array",
        "minItems": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "publishState": {
      "type": "object",
      "description": "Backend-specific manifest identity and publish metadata.",
      "properties": {
        "generation": { "type": "string" },
        "etag": { "type": "string" },
        "backend": { "type": "string" },
        "writer_id": { "type": "string" }
      }
    },
    "shardRef": {
      "type": "object",
      "required": [
        "folder",
        "path",
        "content_sha256",
        "segment_count",
        "min_seq",
        "max_seq",
        "min_commit_seq",
        "max_commit_seq"
      ],
      "properties": {
        "folder": {
          "type": "string",
          "description": "Zero-padded folder name, for example 001"
        },
        "path": {
          "type": "string",
          "description": "Table-relative shard path, for example 001/manifest-shard.json"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the exact shard JSON bytes"
        },
        "segment_count": {
          "type": "integer",
          "minimum": 0
        },
        "min_seq": { "type": "integer" },
        "max_seq": { "type": "integer" },
        "min_commit_seq": { "type": "integer" },
        "max_commit_seq": { "type": "integer" }
      }
    },
    "filesState": {
      "type": "object",
      "required": ["current_subfolder", "subfolder_count", "max_files_per_subfolder"],
      "properties": {
        "current_subfolder": {
          "type": "string"
        },
        "subfolder_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_files_per_subfolder": {
          "type": "integer",
          "minimum": 1
        },
        "total_files": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
